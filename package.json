{
  "name": "sigroute",
  "displayName": "SigRoute - FPGA 信号路由追踪",
  "description": "跨模块追踪 Verilog 信号的路由链路：从哪产生、路由到哪、穿越了哪些模块、在何处被改名。",
  "version": "0.3.6",
  "publisher": "sigroute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zh89468y/sigroute.git"
  },
  "homepage": "https://github.com/zh89468y/sigroute#readme",
  "bugs": {
    "url": "https://github.com/zh89468y/sigroute/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#151a24",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "verilog",
    "fpga",
    "signal",
    "trace",
    "rtl"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onLanguage:verilog-hdl",
    "onCommand:sigroute.traceBoth",
    "onCommand:sigroute.traceDown",
    "onCommand:sigroute.traceUp",
    "onView:sigrouteTrace",
    "onView:sigrouteMindmap"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sigroute.traceBoth",
        "title": "SigRoute: 追踪信号（上游 + 下游）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.traceGraph",
        "title": "SigRoute: 追踪信号并显示框图",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.showGraph",
        "title": "SigRoute: 显示信号框图（当前结果）",
        "category": "SigRoute",
        "enablement": "sigroute.hasResult"
      },
      {
        "command": "sigroute.gotoParentConn",
        "title": "SigRoute: 跳到父层连接处（信号出模块的接口）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.traceDown",
        "title": "SigRoute: 追踪信号下游（路由到哪）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.traceUp",
        "title": "SigRoute: 追踪信号上游（从哪来）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.traceFromName",
        "title": "SigRoute: 按信号名追踪…",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.exportMermaid",
        "title": "SigRoute: 导出路由图为 Mermaid",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.exportMarkdown",
        "title": "SigRoute: 导出路由报告为 Markdown",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.rebuildIndex",
        "title": "SigRoute: 重建工程索引",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.showModuleInfo",
        "title": "SigRoute: 显示当前模块信息",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.showModuleInfoFor",
        "title": "SigRoute: 显示指定模块信息",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.copyPath",
        "title": "SigRoute: 复制信号层次路径",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.findAliases",
        "title": "SigRoute: 查找同网络别名（改名反查）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.tracePort",
        "title": "SigRoute: 追踪模块端口…",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.cycleFilter",
        "title": "SigRoute: 切换过滤（全部 / 只看跨模块 / 只看改名）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.toggleViewMode",
        "title": "SigRoute: 切换树视图 / 脑图",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.directGoto",
        "title": "SigRoute: Ctrl+点击直接跳转（多处定义不再弹预览）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.reveal",
        "title": "SigRoute: 跳转到源码位置（内部）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.traceAt",
        "title": "SigRoute: 追踪该位置上的信号（内部）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.expandChildren",
        "title": "SigRoute: 继续展开该分支（内部）",
        "category": "SigRoute"
      },
      {
        "command": "sigroute.filterSet",
        "title": "SigRoute: 设置树视图过滤（内部）",
        "category": "SigRoute"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sigrouteTrace",
          "name": "SigRoute 信号路由",
          "when": "workspaceFolderCount > 0 && sigroute.viewMode != 'mindmap'"
        },
        {
          "id": "sigrouteMindmap",
          "name": "SigRoute 信号脑图",
          "type": "webview",
          "when": "workspaceFolderCount > 0 && sigroute.viewMode == 'mindmap'"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sigroute.cycleFilter",
          "when": "view == sigrouteTrace && sigroute.filter == all",
          "group": "1_filter@1",
          "icon": "$(list-tree)"
        },
        {
          "command": "sigroute.cycleFilter",
          "when": "view == sigrouteTrace && sigroute.filter == cross",
          "group": "1_filter@1",
          "icon": "$(filter-filled)"
        },
        {
          "command": "sigroute.cycleFilter",
          "when": "view == sigrouteTrace && sigroute.filter == renamed",
          "group": "1_filter@1",
          "icon": "$(symbol-parameter)"
        },
        {
          "command": "sigroute.toggleViewMode",
          "when": "view == sigrouteTrace || view == sigrouteMindmap",
          "group": "1_filter@2",
          "icon": "$(open-preview)"
        },
        {
          "command": "sigroute.rebuildIndex",
          "when": "view == sigrouteTrace || view == sigrouteMindmap",
          "group": "navigation"
        },
        {
          "command": "sigroute.exportMermaid",
          "when": "view == sigrouteTrace",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sigroute.reveal",
          "when": "false"
        },
        {
          "command": "sigroute.traceAt",
          "when": "false"
        },
        {
          "command": "sigroute.expandChildren",
          "when": "false"
        },
        {
          "command": "sigroute.filterSet",
          "when": "false"
        },
        {
          "command": "sigroute.showModuleInfoFor",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "sigroute.traceGraph",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@0"
        },
        {
          "command": "sigroute.traceBoth",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@1"
        },
        {
          "command": "sigroute.traceDown",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@2"
        },
        {
          "command": "sigroute.traceUp",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@3"
        },
        {
          "command": "sigroute.gotoParentConn",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@4"
        },
        {
          "command": "sigroute.copyPath",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@5"
        },
        {
          "command": "sigroute.findAliases",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@6"
        },
        {
          "command": "sigroute.tracePort",
          "when": "editorLangId =~ /verilog|systemverilog/",
          "group": "navigation@7"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sigroute.traceBoth",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.traceBoth",
        "key": "alt+q",
        "mac": "alt+q",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.traceUp",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.traceDown",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.gotoParentConn",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.copyPath",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorLangId =~ /verilog|systemverilog/"
      },
      {
        "command": "sigroute.cycleFilter",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == sigrouteTrace"
      }
    ],
    "configuration": {
      "title": "SigRoute",
      "properties": {
        "sigroute.includeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.v",
            "**/*.sv",
            "**/*.vh",
            "**/*.svh"
          ],
          "description": "参与索引的源文件；支持 glob。被排除的目录不会重复扫描。"
        },
        "sigroute.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/*.cache/**",
            "**/*.sim/**",
            "**/*.runs/**",
            "**/*.hw/**",
            "**/*.ip_user_files/**",
            "**/sigroute/**",
            "**/*_sim_netlist.v",
            "**/*_sim_netlist.vh",
            "**/*_netlist.v"
          ],
          "description": "索引时跳过的目录/文件 glob。默认排除 Vivado 生成目录与 IP 仿真网表。注意：IP 的 *_stub.v 会被保留索引，因为它们是判断 IP 端口方向的唯一依据。"
        },
        "sigroute.defines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外认为已定义的宏（用于 `ifdef 条件编译裁剪）。工程中未被注释的 `define 会被自动识别。"
        },
        "sigroute.undefines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "强制视为未定义的宏，优先级高于自动识别与 sigroute.defines。"
        },
        "sigroute.mermaidDirection": {
          "type": "string",
          "enum": [
            "LR",
            "TD"
          ],
          "default": "LR",
          "description": "Mermaid 导出图的布局方向：LR 横向 / TD 纵向。"
        },
        "sigroute.autoShowGraph": {
          "type": "boolean",
          "default": false,
          "description": "每次追踪后自动打开框图面板（关闭时可用右键菜单“追踪信号并显示框图”按需打开）。"
        },
        "sigroute.graphDirection": {
          "type": "string",
          "enum": [
            "LR",
            "TD"
          ],
          "default": "LR",
          "description": "框图的初始布局方向：LR 横向（上游在左、下游在右）/ TD 纵向。面板内可随时切换。"
        },
        "sigroute.graphHops": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "框图默认显示的跳数：1 = 只显示与选中信号直接关联的模块；0 = 不裁剪显示完整关联图。数据总线类信号扩散很广，建议保持 1~3。"
        },
        "sigroute.maxDepth": {
          "type": "number",
          "default": 30,
          "description": "路由追踪的最大跨模块层数，防止极深或成环的链路导致卡顿。"
        },
        "sigroute.maxNodes": {
          "type": "number",
          "default": 600,
          "description": "单次追踪的节点总数上限。信号扇出很大时（如时钟、复位）用于保护界面流畅。"
        },
        "sigroute.maxChildren": {
          "type": "number",
          "default": 24,
          "description": "单个节点的分支上限，超出只保留前 N 个并给出提示。"
        },
        "sigroute.maxInstancesPerModule": {
          "type": "number",
          "default": 200,
          "description": "单个模块内例化数量上限，超过则视为解析异常并跳过（保护性能）。"
        },
        "sigroute.honorIfdef": {
          "type": "boolean",
          "default": true,
          "description": "是否尊重 `ifdef/`ifndef 条件编译。关闭后将把所有分支都纳入索引（可能出现重复例化）。"
        },
        "sigroute.inlineIncludes": {
          "type": "boolean",
          "default": true,
          "description": "把 `include 的内容内联进解析：端口列表/模块体片段写在 .vh 里的工程需要它才能解析完整（跳转落在 include 指令行）。关闭后与旧版行为一致。"
        },
        "sigroute.blackboxSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.veo",
            "**/*.vho"
          ],
          "description": "仅用于补齐黑盒 IP 端口方向的辅助文件（Vivado 例化模板）。只会补充工程里没有定义的模块，永不覆盖真实实现。"
        },
        "sigroute.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用编辑器内的悬停速查（关闭后悬停不再显示任何信号信息）。"
        },
        "sigroute.hover.sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "decl",
              "drivers",
              "loads",
              "parent",
              "path",
              "aliases"
            ]
          },
          "default": [
            "decl",
            "drivers",
            "loads",
            "parent",
            "path",
            "aliases"
          ],
          "description": "悬停信息框里显示哪些小节（顺序即显示顺序）。decl=声明与位置、drivers=驱动源、loads=负载、parent=上级模块连接、path=层次路径、aliases=同网络别名。清空则不显示任何小节（只留信号名）。"
        },
        "sigroute.hover.declSource": {
          "type": "boolean",
          "default": true,
          "description": "在 decl 小节里原样贴出声明所在的源码（连同上方的注释行），带语法高亮。关闭后只显示位置链接。"
        },
        "sigroute.hover.maxRefs": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 100,
          "description": "悬停信息框里每一节（驱动源 / 负载 / 上级连接 / 层次路径 / 别名）最多列出几条。"
        },
        "sigroute.hover.maxLines": {
          "type": "number",
          "default": 40,
          "minimum": 4,
          "maximum": 500,
          "description": "悬停信息框的最大行数：超出后按节截断并给出提示（调大可以看到更完整的链路）。"
        },
        "sigroute.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "在模块声明行显示 CodeLens（端口数/例化数/被例化次数 + 追踪入口）。"
        },
        "sigroute.indexCache": {
          "type": "boolean",
          "default": true,
          "description": "把索引结果缓存到工作区存储：重启 VSCode 后若文件指纹未变则跳过解析。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "selfcheck": "node tools/check.mjs",
    "selftest": "node tools/selftest.mjs",
    "verify": "node tools/verify.mjs --json",
    "ai": "node tools/ai.mjs",
    "mcp": "node tools/mcp.mjs",
    "icon": "node tools/make-icon.mjs 256",
    "package": "npx --yes @vscode/vsce package",
    "publish:patch": "npx --yes @vscode/vsce publish patch",
    "publish:minor": "npx --yes @vscode/vsce publish minor"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
